# OCULUS Environment Configuration

# -------------------------------------------------------------
# Core Recommended Keys (Free Tier Available)
# -------------------------------------------------------------
# 1. Groq (Free at https://console.groq.com)
#    - Powers ultra-fast Groq Whisper STT + Llama 3.3 70B Versatile (Primary LLM Judge)
GROQ_API_KEY=

# 2. Google Gemini (Free at https://aistudio.google.com)
#    - Powers Gemini Flash (Fallback LLM Judge + VLM Vision Verification for gaze/device checks)
GEMINI_API_KEY=

# -------------------------------------------------------------
# Optional Services
# -------------------------------------------------------------
# 3. Speechmatics (Free credits at https://portal.speechmatics.com)
#    - Multi-speaker native diarization + custom technical vocabulary for mixed audio
SPEECHMATICS_API_KEY=

# 4. Attendee.dev (Only needed if dispatching a bot into live Google Meet/Zoom calls)
ATTENDEE_BASE_URL=https://app.attendee.dev
ATTENDEE_API_KEY=

# -------------------------------------------------------------
# Local Demo Defaults (Pre-configured, no edit needed)
# -------------------------------------------------------------
DEPLOY_MODE=single_node
APP_ENV=development
DEBUG=true

# SQLite local storage (zero setup needed)
DATABASE_URL=sqlite+aiosqlite:///./oculus.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oculus
REDIS_URL=redis://localhost:6379/0

# Storage: "local" saves to ./tmp_storage; "r2" uses Cloudflare R2
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./tmp_storage
PUBLIC_API_URL=http://localhost:8000
